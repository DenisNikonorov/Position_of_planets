<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Публикация</title>
    <link rel="stylesheet" href="/style.css?v=2">
</head>
<body>
    <div class="add-container">
        <h1 class="add-title">Публикация планеты</h1>
        <p class="add-subtitle">Добавьте описание и данные орбиты — шаг 2 из 2</p>

        <div class="publish-preview">
            {{if .planet.HasVideo}}
                {{if .planet.URLVideo}}
                <video class="publish-media" autoplay muted loop playsinline>
                    <source src="{{.planet.URLVideo}}" type="video/mp4">
                </video>
                {{else}}
                <div class="publish-media media-placeholder">Нет медиа</div>
                {{end}}
            {{else}}
                {{if .planet.ImageURL}}
                <img class="publish-media" src="{{.planet.ImageURL}}" alt="{{.planet.Name}}">
                {{else}}
                <div class="publish-media media-placeholder">Нет медиа</div>
                {{end}}
            {{end}}
            <div class="publish-name">{{.planet.Name}}</div>
        </div>

        <form action="/add/{{.planet.ID}}" method="POST">
            <div class="form-group">
                <label class="add-label">Описание</label>
                <textarea name="description" class="form-input" placeholder="Описание планеты..." required>{{.planet.Description}}</textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="add-label">Расстояние (AU)</label>
                    <input type="text" name="distance" class="form-input" placeholder="0.00" required{{if .planet.DistanceFromSun}} value="{{.planet.DistanceFromSun}}"{{end}}>
                </div>
                <div class="form-group">
                    <label class="add-label">Дата наблюдения</label>
                    <input type="date" name="observation_date" class="form-input" required value="{{.planet.ObservationDate}}">
                </div>
            </div>

            <button type="submit" class="step-btn">Опубликовать</button>
        </form>
    </div>

    <nav class="bottom-nav">
        <a href="/feed" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="3"/>
                <line x1="12" y1="2" x2="12" y2="5"/>
                <line x1="12" y1="19" x2="12" y2="22"/>
                <line x1="2" y1="12" x2="5" y2="12"/>
                <line x1="19" y1="12" x2="22" y2="12"/>
            </svg>
            Лента
        </a>
        <a href="/add" class="nav-item active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="16"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
            </svg>
            Добавить
        </a>
        <a href="/tile" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Плитка
        </a>
    </nav>
</body>
</html>