<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Планеты</title>
    <link rel="stylesheet" href="/styles/planets_style.css">
</head>
<body>
    <header class="site-header">
        <a href="/planets" class="home-link">
            <span class="logo-text">ОБСЕРВАТОРИЯ</span>
        </a>
        <div class="likes-icon">
            <svg viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            {{ if ne .liked_count 0 }}
            <span class="likes-count">{{ .liked_count }}</span>
            {{ end }}
        </div>
    </header>
    <div class="container">
        <div class="search-bar">
            <form action="/planets" method="GET">
                <input type="text" name="search" placeholder="Поиск планеты" value="{{ .search }}">
            </form>
        </div>
        <div class="content">
            {{ range .data }}
            <div class="planet-card">
                <a href="/planets/{{ .ID }}" class="planet-link">
                    <div class="avatar">
                        {{ if .HasVideo }}
                            {{ if .URLVideo }}
                            <video autoplay muted loop playsinline>
                                <source src="{{ .URLVideo }}" type="video/mp4">
                            </video>
                            {{ else }}
                            <div class="media-placeholder">{{ .Name }}</div>
                            {{ end }}
                        {{ else }}
                            {{ if .ImageURL }}
                            <img src="{{ .ImageURL }}" alt="{{ .Name }}">
                            {{ else }}
                            <div class="media-placeholder">{{ .Name }}</div>
                            {{ end }}
                        {{ end }}
                    </div>
                    <div class="planet-info">
                        <h3>{{ .Name }}</h3>
                        <p>{{ .Description }}</p>
                        <div class="planet-meta">
                            <span class="planet-likes">
                                <svg viewBox="0 0 24 24">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                </svg>
                                {{ .LikesCount }}
                            </span>
                            <span class="planet-distance">{{ .DistanceFromSun }} AU</span>
                        </div>
                    </div>
                </a>
                <form action="/delete-planet" method="POST" class="delete-form">
                    <input type="hidden" name="planet_id" value="{{ .ID }}">
                    <button type="submit" class="delete-btn" title="Удалить планету">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            <line x1="10" y1="11" x2="10" y2="17"/>
                            <line x1="14" y1="11" x2="14" y2="17"/>
                        </svg>
                    </button>
                </form>
            </div>
            {{ end }}
        </div>
    </div>
</body>
</html>